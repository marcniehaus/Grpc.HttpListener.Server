<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.Tools" Version="2.83.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Grpc.Net.Common" Version="2.83.0"/>
    <PackageReference Include="Google.Protobuf" Version="3.36.1"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Grpc.HttpListener.Server/Grpc.HttpListener.Server.csproj"/>
    <!--
    <ProjectReference Include="../test/test.csproj"/>
      -->
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="../../test/Grpc.HttpListener.Server.Tests/TestMethods.proto" GrpcServices="Both" />
  </ItemGroup>
</Project>
